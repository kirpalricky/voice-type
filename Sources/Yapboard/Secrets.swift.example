/// Template for local secrets configuration.
/// Copy this to Secrets.swift and fill in actual values.
/// Secrets.swift is gitignored and should not be committed.

enum Secrets {
    /// Sentry DSN for native crash reporting (yapboard-crashes project).
    /// If empty, Sentry initialization will be disabled.
    /// Override via SENTRY_DSN environment variable at runtime.
    static let dsn = ""

    /// Sentry DSN for non-fatal error reporting (yapboard-errors project).
    /// If empty, non-fatal errors won't be sent to a separate project.
    static let errorsDSN = ""
}
